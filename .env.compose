# ===========================================================
# KarigarSetu — Docker Compose Environment Variables
# Copy this file and fill in real values:
#   cp .env.compose .env.compose.local
#
# Usage:
#   docker compose --env-file .env.compose.local up -d
#
# NEVER commit .env.compose.local to version control.
# ===========================================================

# ---- GitHub Container Registry ----
GITHUB_REPOSITORY_OWNER=your-github-username
IMAGE_TAG=latest

# ---- Backend ----
MONGODB_URI=mongodb+srv://<username>:<password>@cluster.mongodb.net/karigarsetu?retryWrites=true&w=majority
JWT_SECRET=your_super_secret_jwt_key_change_in_production
JWT_EXPIRES_IN=7d
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760

# ---- Frontend build args ----
# These are baked into the Next.js build — set to your public API URLs
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_AI_URL=http://localhost:8000

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000

# ---- AI Service ----
HF_TOKEN=your_huggingface_token_here
TABPFN_TOKEN=your_tabpfn_token_here
WHISPER_MODEL=medium
# DEVICE=cuda   # Uncomment to force GPU mode
