{
  "expo": {
    "name": "KarigarSetu",
    "slug": "karigarsetu",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "scheme": "karigarsetu",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0f0c0a"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.karigarsetu.app"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0f0c0a",
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "package": "com.karigarsetu.app",
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-image-picker",
        {
          "photosPermission": "KarigarSetu needs access to your photos to add product images.",
          "cameraPermission": "KarigarSetu needs access to your camera to capture product photos."
        }
      ],
      "expo-secure-store",
      "expo-splash-screen"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
