# ============================================================
# KarigarSetu Backend — Environment Variables
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# Server
PORT=5000
NODE_ENV=development

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://<user>:<password>@<cluster>.mongodb.net/<dbname>?retryWrites=true&w=majority

# JWT
JWT_SECRET=change_me_to_a_strong_random_secret
JWT_EXPIRES_IN=7d

# AI Service (internal Docker network: http://ai:8000 | local: http://localhost:8000)
AI_SERVICE_URL=http://localhost:8000

# CORS — comma-separated origins (e.g. http://localhost:3000,https://yourdomain.com)
CORS_ORIGIN=http://localhost:3000

# File Uploads
UPLOAD_DIR=uploads
MAX_FILE_SIZE=10485760
