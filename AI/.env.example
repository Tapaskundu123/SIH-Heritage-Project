# =======================================================
# KarigarSetu AI Service Environment Configuration
# =======================================================

# Hugging Face API Token (Required for IndicConformer Multilingual & Qwen)
# 1. Get your token at: https://huggingface.co/settings/tokens
# 2. Accept terms for IndicConformer at: https://huggingface.co/ai4bharat/indic-conformer-600m-multilingual
HF_TOKEN=your_hugging_face_api_token_here

# Whisper ASR model for fallback (tiny, base, small, medium, large-v3)
WHISPER_MODEL=medium

# Device configuration (auto-detects cuda or cpu)
# DEVICE=cuda
